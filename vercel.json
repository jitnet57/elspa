{
  "$schema": "https://vercel.com/schemas/vercel.json",
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "runtime": "python@3.11"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    }
  ]
}
