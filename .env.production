# ============================================================
# 📌 .env.production - 프로덕션 환경 설정
# 📋 목적: 프로덕션 서버 (⚠️ 민감 정보 포함!)
# 🔒 .gitignore에 추가됨 - 절대 커밋하지 말 것!
# 📅 작성일: 2026-05-22
# ============================================================

# ==========================================
# 🔒 경고: 이 파일은 버전 관리에서 제외됨!
# ==========================================
# .env.production은 .gitignore에 있습니다.
# 프로덕션 배포 시 CI/CD (GitHub Actions)에서
# GitHub Secrets를 통해 환경 변수를 주입합니다.

# ==========================================
# 🔧 환경 설정
# ==========================================
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=WARNING

# ==========================================
# 💾 데이터베이스 (Supabase Production)
# ==========================================
# GitHub Secrets: DATABASE_URL
# DATABASE_URL=postgresql://user:password@prod-db.supabase.co:5432/postgres

# ==========================================
# 🔐 JWT 설정 (강력한 값 필수!)
# ==========================================
# GitHub Secrets: JWT_SECRET_KEY
# JWT_SECRET_KEY=<생성된 매우 강력한 256비트 값>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==========================================
# 🌐 CORS 설정 (프로덕션 도메인)
# ==========================================
CORS_ORIGINS=https://elspa.com,https://www.elspa.com

# ==========================================
# 🚀 API 설정
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=8

# ==========================================
# 🌍 Next.js 설정
# ==========================================
NEXT_PUBLIC_API_URL=https://api.elspa.com
NEXT_PUBLIC_APP_NAME=ElSpa Manager

# ==========================================
# 📊 모니터링 & 로깅
# ==========================================
# Sentry (프로덕션 에러 추적)
# GitHub Secrets: SENTRY_DSN
# SENTRY_DSN=

# CloudFlare (CDN/WAF)
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# ==========================================
# 🔌 서비스 설정 (GitHub Secrets)
# ==========================================
# Supabase Production
# SUPABASE_URL=https://prod.supabase.co
# SUPABASE_KEY=

# AWS (이메일, 스토리지 등)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1

# 이메일 (AWS SES)
# SMTP_HOST=email.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ==========================================
# 🎯 배포 설정
# ==========================================
# 프로덕션 배포 시 이 파일은 사용되지 않습니다.
# 대신 CI/CD 파이프라인이 GitHub Secrets를 직접 주입합니다.
#
# 로컬 프로덕션 테스트:
#   1. .env.production.local 파일 생성 (개인용, .gitignore됨)
#   2. 민감한 값만 입력
#   3. 로컬 테스트 후 즉시 삭제
