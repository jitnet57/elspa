# ============================================================
# 📌 .env.staging - 스테이징 환경 설정
# 📋 목적: Staging 서버 설정 (테스트 전 배포)
# 📅 작성일: 2026-05-22
# ============================================================

# ==========================================
# 🔧 환경 설정
# ==========================================
DEBUG=false
ENVIRONMENT=staging
LOG_LEVEL=INFO

# ==========================================
# 💾 데이터베이스 (Supabase Staging)
# ==========================================
# 환경 변수로 GitHub Secrets 사용
# DATABASE_URL은 .github/secrets에서 주입
# DATABASE_URL=postgresql://user:password@staging-db.supabase.co:5432/postgres

# ==========================================
# 🔐 JWT 설정
# ==========================================
# JWT_SECRET_KEY는 .github/secrets에서 주입
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==========================================
# 🌐 CORS 설정
# ==========================================
CORS_ORIGINS=https://staging.elspa.com,https://www.staging.elspa.com

# ==========================================
# 🚀 API 설정
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ==========================================
# 🌍 Next.js 설정
# ==========================================
NEXT_PUBLIC_API_URL=https://api.staging.elspa.com
NEXT_PUBLIC_APP_NAME=ElSpa Manager (Staging)

# ==========================================
# 📊 모니터링 & 로깅
# ==========================================
# Sentry (에러 추적)
# SENTRY_DSN=

# ==========================================
# 🔌 서비스 설정
# ==========================================
# Supabase
# SUPABASE_URL=https://staging.supabase.co
# SUPABASE_KEY=

# 이메일 (AWS SES 등)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
