{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "nodeVersion": "18.x",
  "env": {
    "NEXT_PUBLIC_API_URL": "@api_url",
    "NEXT_PUBLIC_KAKAO_API_KEY": "@kakao_api_key",
    "NEXT_PUBLIC_SMS_API_KEY": "@sms_api_key",
    "NEXT_PUBLIC_GOOGLE_API_KEY": "@google_api_key",
    "NEXT_PUBLIC_GOOGLE_SHEET_ID": "@google_sheet_id",
    "EMAIL_SMTP_SERVER": "@email_smtp_server",
    "CRON_SECRET": "@cron_secret",
    "ADMIN_EMAILS": "@admin_emails",
    "ADMIN_PHONES": "@admin_phones",
    "EMAIL_API_KEY": "@email_api_key",
    "GOOGLE_API_TOKEN": "@google_api_token"
  },
  "crons": [
    {
      "path": "/api/scheduler/daily-settlement-report",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/scheduler/daily-settlement-report",
      "schedule": "0 12 * * *"
    }
  ]
}
