{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/customer/layout,_N_T_/customer/mypage/layout,_N_T_/customer/mypage/page,_N_T_/customer/mypage"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/customer/mypage/__PAGE__",
    "/customer/mypage",
    "/customer",
    "/_index",
    "/_head"
  ]
}