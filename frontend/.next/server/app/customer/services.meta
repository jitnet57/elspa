{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/customer/layout,_N_T_/customer/services/layout,_N_T_/customer/services/page,_N_T_/customer/services"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/customer/services/__PAGE__",
    "/customer/services",
    "/customer",
    "/_index",
    "/_head"
  ]
}