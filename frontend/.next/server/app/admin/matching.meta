{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/admin/layout,_N_T_/admin/matching/layout,_N_T_/admin/matching/page,_N_T_/admin/matching"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/admin/matching/__PAGE__",
    "/admin/matching",
    "/admin",
    "/_index",
    "/_head"
  ]
}