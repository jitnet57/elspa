# ============================================================
# 📌 ElSpa 환경 설정
# 📋 목적: FastAPI 백엔드 설정 (개발/테스트용)
# 📅 작성일: 2026-05-18
# ============================================================

# 🗄️ 데이터베이스 설정
# 개발용: SQLite 사용
DATABASE_URL=sqlite:///./test.db

# Supabase 설정 (Sprint 12: 실제 연결 준비)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SECRET_KEY=your_service_role_key
SUPABASE_JWT_TOKEN=your_jwt_token
SUPABASE_SERVICE_ROLE_JWT=your_service_role_jwt
USE_SUPABASE=false

# API 설정
API_VERSION=1.0.0
DEBUG=True
ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Claude API
ANTHROPIC_API_KEY=sk-proj-your-key

# Messenger APIs
KAKAO_REST_API_KEY=your-key
KAKAO_APP_ID=your-id
WHATSAPP_TOKEN=your-token

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
