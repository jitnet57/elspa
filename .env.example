# ============================================================
# 카카오 API 설정
# ============================================================
KAKAO_APP_ID=YOUR_KAKAO_APP_ID
KAKAO_REST_API_KEY=YOUR_REST_API_KEY
KAKAO_ADMIN_KEY=YOUR_ADMIN_KEY

# ============================================================
# WhatsApp Business API (Meta)
# ============================================================
WHATSAPP_TOKEN=your_whatsapp_business_account_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta_console
WHATSAPP_VERIFY_TOKEN=elspa_verify

# ============================================================
# 메신저봇 쇼핑몰 URL
# ============================================================
SHOP_URL=https://yoursite.com/booking

# ============================================================
# API 설정
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_ENVIRONMENT=development

# ============================================================
# Frontend API & WebSocket URLs (Next.js에서 사용)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/driver

# ============================================================
# 데이터베이스
# ============================================================
DATABASE_URL=postgresql://user:password@localhost/elspa

# ============================================================
# Supabase (백엔드용 - service_role 등)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# ============================================================
# Supabase (프론트엔드 직접 연동 - 백엔드 없는 모니터용)
# ⚠️ anon 키만 사용 (RLS로 보호). service_role 키는 절대 넣지 말 것.
# ============================================================
NEXT_PUBLIC_USE_SUPABASE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================
# JWT 인증
# ============================================================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Claude API
# ============================================================
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================================
# Twilio (WhatsApp Business API)
# ============================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+1234567890

# ============================================================
# Kakao Business Message API
# ============================================================
KAKAO_API_KEY=your_kakao_business_api_key
KAKAO_ADMIN_KEY=your_kakao_admin_key

# ============================================================
# Phase 10-2: Monitoring & Logging Configuration
# ============================================================

# Logging
LOG_DIR=./logs
JSON_LOGS=true

# Sentry (에러 추적 & APM)
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production

# Slack (알림)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# SMTP (Email 알림)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerting@example.com
SMTP_PASSWORD=your_smtp_password

# PagerDuty (선택)
PAGERDUTY_API_KEY=your_pagerduty_api_key
PAGERDUTY_SERVICE_ID=your_service_id

# Elasticsearch (로그 저장소)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PROTOCOL=http

# Prometheus (메트릭 저장소)
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

# 모니터링 설정
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
