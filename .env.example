# ============================================================
# ElSpa Backend 환경 변수 템플릿
# ============================================================
# 이 파일을 복사해서 .env 파일을 만들고 값을 입력하세요
# cp .env.example .env
# ============================================================

# ============================================================
# 📌 데이터베이스 연결 (필수)
# ============================================================
# Supabase PostgreSQL 연결 문자열
# https://app.supabase.com → Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres.[project_id]:[password]@db.supabase.co:5432/postgres

# ============================================================
# 🌐 서버 설정
# ============================================================
# 포트 번호 (기본값: 8000)
PORT=8000

# 환경 (development / staging / production)
ENVIRONMENT=development

# Python 출력 버퍼링 비활성화 (Docker용)
PYTHONUNBUFFERED=1

# ============================================================
# 🔐 CORS 설정
# ============================================================
# 허용할 프론트엔드 도메인 (쉼표로 구분)
# 로컬 개발: http://localhost:3000
# 프로덕션: https://elspa.pages.dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://elspa.pages.dev

# ============================================================
# 📱 구글 연동 (선택사항)
# ============================================================
# Google Drive API
GOOGLE_DRIVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# 🔔 알림/로깅 (선택사항)
# ============================================================
# Sentry (에러 모니터링)
SENTRY_DSN=

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR / CRITICAL)
LOG_LEVEL=INFO

# ============================================================
# 💳 결제 (선택사항)
# ============================================================
# Stripe, PayPal 등의 결제 게이트웨이 키
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=

# ============================================================
# 📧 이메일 (선택사항)
# ============================================================
# SMTP 서버 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================================
# 🔐 보안 (필요시 변경)
# ============================================================
# JWT 시크릿 키 (프로덕션에서는 강력한 임의 문자열 사용)
SECRET_KEY=your-secret-key-change-in-production

# API 키 (프론트엔드 인증용)
API_KEY=

# ============================================================
# 📊 분석 (선택사항)
# ============================================================
# Google Analytics
GOOGLE_ANALYTICS_ID=

# ============================================================
# 🗄️ 캐시 (선택사항)
# ============================================================
# Redis (분산 캐시용)
REDIS_URL=redis://localhost:6379/0
