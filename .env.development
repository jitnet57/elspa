# ============================================================
# 📌 .env.development - 개발 환경 설정
# 📋 목적: 로컬 개발 서버 (localhost) 설정
# 📅 작성일: 2026-05-22
# ============================================================

# ==========================================
# 🐛 디버그 설정
# ==========================================
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ==========================================
# 💾 데이터베이스 (로컬 SQLite)
# ==========================================
# 옵션 1: SQLite (가장 간단)
DATABASE_URL=sqlite:///elspa.db

# 옵션 2: 로컬 PostgreSQL
# DATABASE_URL=postgresql://elspa_user:elspa_password@localhost:5432/elspa_dev

# ==========================================
# 🔐 JWT 설정
# ==========================================
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==========================================
# 🌐 CORS 설정
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ==========================================
# 🚀 API 설정
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ==========================================
# 🌍 Next.js 설정
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ElSpa Manager (Dev)

# ==========================================
# 🔌 선택 서비스
# ==========================================
# Supabase (개발용 비활성화 가능)
# SUPABASE_URL=
# SUPABASE_KEY=

# Redis (선택사항)
# REDIS_URL=redis://localhost:6379/0
